{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Unio chart values",
  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "dnsName": {
      "type": "string",
      "maxLength": 253,
      "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
    },
    "ingressHost": {
      "type": "string",
      "maxLength": 253,
      "pattern": "^(\\*\\.)?[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
    },
    "duration": {
      "type": "string",
      "pattern": "^[0-9]+(ms|s|m|h)$"
    },
    "quantity": {
      "type": "string",
      "pattern": "^[0-9]+(\\.[0-9]+)?(Ki|Mi|Gi|Ti|Pi|Ei|k|M|G|T|P|E)?$"
    },
    "unioSize": {
      "type": "string",
      "pattern": "^[0-9]+ ?([bB]|[kKmMgGtT]([iI][bB]|[bB])?)?$"
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "type": "string" },
        "annotations": { "type": "object" },
        "hosts": {
          "type": "array",
          "maxItems": 16,
          "items": { "$ref": "#/definitions/ingressHost" }
        },
        "tls": { "type": "array", "items": { "type": "object" } }
      }
    }
  },
  "properties": {
    "nameOverride": { "type": "string", "maxLength": 50 },
    "fullnameOverride": {
      "type": "string",
      "maxLength": 50,
      "pattern": "^([a-z]([-a-z0-9]*[a-z0-9])?)?$"
    },
    "clusterDomain": { "$ref": "#/definitions/dnsName" },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": { "type": "string", "minLength": 1, "maxLength": 255 },
        "tag": {
          "type": "string",
          "pattern": "^([A-Za-z0-9_][A-Za-z0-9_.-]{0,127})?$"
        },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "imagePullSecrets": { "type": "array", "items": { "type": "object" } },
    "replicas": { "type": "integer", "minimum": 1, "maximum": 256 },
    "drivesPerNode": { "type": "integer", "minimum": 1, "maximum": 16 },
    "persistence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "size": { "$ref": "#/definitions/quantity" },
        "storageClass": { "type": "string" },
        "accessModes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "enum": ["ReadWriteOnce", "ReadWriteOncePod"] }
        },
        "annotations": { "type": "object" }
      }
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "region": { "type": "string", "pattern": "^[a-z0-9-]{1,32}$" },
        "domains": {
          "type": "array",
          "maxItems": 16,
          "items": { "$ref": "#/definitions/dnsName" }
        },
        "storageSync": { "type": "string", "enum": ["always", "batch"] },
        "memoryBudget": { "$ref": "#/definitions/unioSize" },
        "logLevel": { "type": "string", "enum": ["debug", "info", "warn", "error"] },
        "logFormat": { "type": "string", "enum": ["json", "text"] },
        "erasure": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "setDriveCount": { "type": "integer", "minimum": 0, "maximum": 16 },
            "parity": { "type": "integer", "minimum": 0, "maximum": 8 }
          }
        }
      }
    },
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "existingSecret": {
          "type": "string",
          "maxLength": 253,
          "pattern": "^([a-z0-9]([-a-z0-9.]*[a-z0-9])?)?$"
        }
      }
    },
    "tls": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "existingSecret": {
          "type": "string",
          "maxLength": 253,
          "pattern": "^([a-z0-9]([-a-z0-9.]*[a-z0-9])?)?$"
        },
        "require": { "type": "boolean" }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "token": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" }
          }
        },
        "serviceMonitor": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "interval": { "$ref": "#/definitions/duration" },
            "scrapeTimeout": {
              "type": "string",
              "pattern": "^([0-9]+(ms|s|m|h))?$"
            },
            "labels": { "type": "object" },
            "tlsConfig": { "type": "object" }
          }
        }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "annotations": { "type": "object" }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "s3From": { "type": "array", "items": { "type": "object" } }
      }
    },
    "podDisruptionBudget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "s3": { "$ref": "#/definitions/ingress" },
        "console": { "$ref": "#/definitions/ingress" }
      }
    },
    "antiAffinity": { "type": "string", "enum": ["preferred", "required", "none"] },
    "nodeSelector": { "type": "object" },
    "tolerations": { "type": "array", "items": { "type": "object" } },
    "podLabels": { "type": "object" },
    "podAnnotations": { "type": "object" },
    "priorityClassName": { "type": "string" },
    "resources": { "type": "object" },
    "probes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "startupFailureThreshold": { "type": "integer", "minimum": 1, "maximum": 1000 }
      }
    },
    "terminationGracePeriodSeconds": { "type": "integer", "minimum": 1, "maximum": 3600 },
    "extraEnv": { "type": "array", "items": { "type": "object" } }
  }
}
