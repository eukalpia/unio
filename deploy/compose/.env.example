# Environment for the local Unio and MinIO compose clusters.
#
# Setup:
#   cp deploy/compose/.env.example deploy/compose/.env
#   chmod 600 deploy/compose/.env        (on Windows, restrict the file to your user)
#   then replace every REPLACE value below with a real one.
#
# The placeholders are deliberately too short for the server minimums
# (Unio: cluster secret and metrics token 32 characters, root user 12,
# root password 32; MinIO: root password 8). The servers refuse to start
# until they are replaced.
#
# Unio values: `unio init --output .env` writes a 0600 env-format file with
# the Unio values. Use it to generate UNIO_CLUSTER_SECRET, UNIO_ROOT_USER,
# UNIO_ROOT_PASSWORD and UNIO_METRICS_TOKEN, then add the MINIO_ values below.
#
# This file is for local use only. The real .env is git-ignored. Never commit
# real values, and never copy them into compose files or docs.
#
# MinIO release tag: minio-4x4.yml pins minio/minio:RELEASE.2025-09-07T16-13-09Z
# and must be confirmed by a maintainer before use.

# Unio cluster (cluster-4x4.yml)
UNIO_CLUSTER_SECRET=REPLACE_WITH_UNIO_INIT_OUTPUT
UNIO_ROOT_USER=REPLACE_ME
UNIO_ROOT_PASSWORD=REPLACE_WITH_UNIO_INIT_OUTPUT
UNIO_METRICS_TOKEN=REPLACE_WITH_UNIO_INIT_OUTPUT

# MinIO comparison cluster (minio-4x4.yml)
MINIO_ROOT_USER=REPLACE
MINIO_ROOT_PASSWORD=REPLACE
